# Copy these settings to the ignored repository-root .env (never commit secrets).
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_API_KEY=
MODEL_ID=hackathon-chat

# Explicit fallback only; live smoke tests never silently switch providers.
USE_BEDROCK=0
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
CHAT_MODEL_ID=hackathon-chat
IMAGE_MODEL_ID=hackathon-image
EMBEDDING_MODEL_ID=hackathon-embedding
# Configure an AWS profile/standard credential chain or set this bearer token.
AWS_BEARER_TOKEN_BEDROCK=

# Conservative per-process pacing; the workshop's quota is shared by the team.
MODEL_MIN_INTERVAL_S=3
