# Copy to .env (never commit .env). Local dev defaults shown; production values come from Linode.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/followit
# On the VM: postgresql://USER:PASS@HOST:PORT/defaultdb?sslmode=require
S3_ENDPOINT=https://us-sea-1.linodeobjects.com
S3_BUCKET=followit-trails
S3_KEY=
S3_SECRET=
LAB_KEY=change-me-to-a-random-32-char-string
# Optional, operator-enrolled model research. Leave disabled until collection is arranged.
# Use a private persistent mounted directory, or configured private S3 storage.
RESEARCH_RECORDINGS_DIR=
# Optional verified shadow-only artifact directory; restart to load a new artifact.
SHADOW_MODEL_DIR=
POW_BITS=18
# Caddy serves HTTPS for DOMAIN. No DNS setup needed with sslip.io: VM IP 172.104.5.6 -> 172-104-5-6.sslip.io
DOMAIN=localhost
PATH_VERSION=smooth_v2
PUBLIC_URL=https://localhost
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Person 2's worker
API_BASE=http://localhost:8000
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_API_KEY=
MODEL_ID=hackathon-chat

# AWS Bedrock (optional). The agents are built on the Strands Agents SDK, which can run
# against Bedrock instead of the Akamai endpoint. Leave USE_BEDROCK=0 to use Akamai.
# BEDROCK_MODEL_ID must be a model your AWS account actually has access to, and must
# honour toolChoice (Claude-class) because the agents force structured output.
USE_BEDROCK=0
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
