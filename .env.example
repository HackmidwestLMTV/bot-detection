# Copy to .env (never commit .env). Local dev defaults shown; production values come from Linode.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/followit
# On the VM: postgresql://USER:PASS@HOST:PORT/defaultdb?sslmode=require
S3_ENDPOINT=https://us-sea-1.linodeobjects.com
S3_BUCKET=followit-trails
S3_KEY=
S3_SECRET=
LAB_KEY=change-me-to-a-random-32-char-string
POW_BITS=18
# Caddy serves HTTPS for DOMAIN. No DNS setup needed with sslip.io: VM IP 172.104.5.6 -> 172-104-5-6.sslip.io
DOMAIN=localhost
PUBLIC_URL=https://localhost
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Person 2's worker
API_BASE=http://localhost:8000
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_API_KEY=
MODEL_ID=hackathon-chat
